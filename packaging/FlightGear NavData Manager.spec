# -*- mode: python ; coding: utf-8 -*-
#
# Portable by design: every path is derived from SPECPATH (this file's
# own directory, provided by PyInstaller at build time), never from the
# machine this was built on or the CWD the build was invoked from --
# `pyinstaller packaging/FlightGear NavData Manager.spec` works the
# same from any directory, on any machine.

import os

PROJECT_ROOT = os.path.dirname(SPECPATH)  # noqa: F821 -- SPECPATH is injected by PyInstaller
ENTRY_SCRIPT = os.path.join(SPECPATH, "entry_point.py")  # noqa: F821
SRC_DIR = os.path.join(PROJECT_ROOT, "src")
THEME_ASSETS = os.path.join(SRC_DIR, "flightgear_navdata_manager", "presentation", "theme", "assets")
# Generated by tools/build_brand_assets.py from assets/brand/app_icon.svg.
APP_ICON = os.path.join(SPECPATH, "AppIcon.icns")  # noqa: F821

a = Analysis(
    [ENTRY_SCRIPT],
    pathex=[SRC_DIR],
    binaries=[],
    # The theme's icon SVGs (+ their LICENSE) and brand assets, at the same package-relative
    # path the code loads them from.
    datas=[(THEME_ASSETS, "flightgear_navdata_manager/presentation/theme/assets")],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='FlightGear NavData Manager',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=True,
    upx_exclude=[],
    name='FlightGear NavData Manager',
)
app = BUNDLE(
    coll,
    name='FlightGear NavData Manager.app',
    icon=APP_ICON,
    bundle_identifier='com.flightgearnavdatamanager.app',
    # Keep in sync with pyproject.toml's [project].version.
    version='0.1.0',
    info_plist={
        'CFBundleShortVersionString': '0.1.0',
        'CFBundleVersion': '1',
        # Matches the actual minimum OS PySide6/Qt6 links against on
        # this build (confirmed via `codesign -dv`'s VersionMin field);
        # re-check if the PySide6 dependency version changes.
        'LSMinimumSystemVersion': '11.0',
        'NSHumanReadableCopyright': 'FlightGear NavData Manager',
    },
)
